# Scaffold .gitignore for a PSXRecomp game repository (New Project Layout).
# Aligned with docs/ci/templates/game.gitignore.

# Build outputs
/build/
/build-*/
/out/
/.happypath/

# Setup-host: players Generate game C locally (CI clears generated/).
/generated/

# Release packaging
/release-stage/
/dist/
*.zip

# Local PlayStation assets (never commit dumps / BIOS)
/bios/
/isos/
/saves/
/prepared_disc/
/disc/
.settings/

# Disc / image / memcard formats
*.bin
*.cue
*.iso
*.img
*.sub
*.ccd
*.mcd
*.mcr
*.chd
*.car
SCPH*.BIN

# Local path/config stubs
bios.cfg
disc.cfg
rom.cfg
settings.toml

# Ghidra / local analysis
/ghidra/projects/
*.gpr
*.rep/
*.lock
*.lock~

# Editor / cache
.vs/
.vscode/
*.user
*.log
.DS_Store
__pycache__/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# Runtime artifacts from psx-runtime launches
psx_crash.txt
psx_last_run_report.json
psx_screenshot.bmp
psx_freeze_heartbeat.json
starvation_dump.jsonl

# Diagnostic dumps (root-level) — keep catalog / probe trackable
/*.json
/*.bmp
/*.png
!/catalog_identity.json
!/disc_probe.json

# Third-party launcher checkout (clone separately; see README)
/recomp-ui/

# Runtime stdout captures from local test launches
/rel_stdout.txt
/dbg_stdout.txt

# Freeze diagnostics: one ~109MB state snapshot per wedge
/psx_freeze_dump_*.json

# Framework checkout lives here (see README); not part of this repo
/psxrecomp/

# Local run logs
/run_stdout.txt
/run_stderr.txt

# Generated Vice mod embeds bytes from the Vice hack -- never commit it.
/mods/packages/dw.vanilla.vice/
